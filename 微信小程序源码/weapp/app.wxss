/* 全局样式与主题变量 */
page {
  --color-primary: #165dff;
  --color-gradient-start: #4080ff;
  --color-gradient-end: #165dff;

  --color-bg-page: #f5f6f7;
  --color-bg-card: #ffffff;

  --color-text-primary: #1d2129;
  --color-text-secondary: #4e5969;
  --color-text-tertiary: #86909c;
  --color-text-disabled: #c9cdd4;

  --color-border: #e5e6eb;
  --color-divider: #f2f3f5;

  --color-temp: #ff7d00;
  --color-humidity: #165dff;
  --color-distance: #722ed1;
  --color-light: #ffb400;

  --color-online: #00b42a;
  --color-alarm: #f53f3f;

  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-button: 48rpx;

  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);

  background-color: #f5f6f7;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC',
    'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  color: #1d2129;
}

view,
text,
button,
input,
scroll-view,
switch {
  box-sizing: border-box;
}
