.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background-color: var(--color-bg-page);
}

/* 状态横幅 */
.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.banner-online {
  background: linear-gradient(135deg, #2ac864, #00a03a);
}

.banner-offline {
  background: linear-gradient(135deg, #9aa3ad, #6e7681);
}

.banner-left {
  display: flex;
  align-items: center;
}

.banner-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ffffff;
  margin-right: 18rpx;
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.25);
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.banner-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 错误提示 */
.tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  border-radius: var(--radius-md);
  background-color: #ffece8;
  border: 2rpx solid #ffd2cc;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-alarm);
}

.tip-action {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  margin-left: 20rpx;
}

/* 数据卡片 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 24rpx;
}

.card {
  width: 48.8%;
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.card-head {
  display: flex;
  align-items: center;
}

.card-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
}

.card-icon-temp {
  background-color: var(--color-temp);
}

.card-icon-humidity {
  background-color: var(--color-humidity);
}

.card-icon-distance {
  background-color: var(--color-distance);
}

.card-icon-light {
  background-color: var(--color-light);
}

.card-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.card-value {
  margin-top: 18rpx;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.1;
  color: var(--color-text-primary);
}

.card-value-temp {
  color: var(--color-temp);
}

.card-value-humidity {
  color: var(--color-humidity);
}

.card-value-distance {
  color: var(--color-distance);
}

.card-value-light {
  color: var(--color-light);
  font-size: 42rpx;
}

.card-unit {
  margin-left: 6rpx;
  font-size: 26rpx;
  font-weight: 400;
}

.card-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 执行器状态 */
.section {
  margin-top: 12rpx;
  padding: 8rpx 28rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.section-title {
  padding: 24rpx 0 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.row-last {
  border-bottom: none;
}

.row-left {
  display: flex;
  flex-direction: column;
}

.row-label {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.row-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.pill {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-button);
  font-size: 24rpx;
}

.pill-on {
  background-color: #e8ffea;
  color: var(--color-online);
}

.pill-off {
  background-color: #f2f3f5;
  color: var(--color-text-tertiary);
}

.pill-alarm {
  background-color: #ffece8;
  color: var(--color-alarm);
}

.footer {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}
