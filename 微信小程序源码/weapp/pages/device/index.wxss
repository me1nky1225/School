.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background-color: var(--color-bg-page);
}

.panel {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.panel-tip {
  margin-top: 12rpx;
  margin-bottom: 24rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--color-text-tertiary);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--color-divider);
}

.row-last {
  border-bottom: none;
}

.row-label {
  font-size: 27rpx;
  color: var(--color-text-secondary);
}

.row-value {
  max-width: 62%;
  font-size: 27rpx;
  color: var(--color-text-primary);
  word-break: break-all;
  text-align: right;
}

/* 下拉选择 */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 26rpx;
  border-radius: var(--radius-md);
  background-color: #f7f8fa;
}

.picker-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
}

/* 按钮 */
.btn {
  margin-top: 12rpx;
  font-size: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: var(--radius-button);
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
}

.btn[disabled] {
  opacity: 0.6;
}

.result {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  line-height: 1.5;
}

.result-ok {
  background-color: #e8ffea;
  color: var(--color-online);
}

.result-error {
  background-color: #ffece8;
  color: var(--color-alarm);
}

.desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
